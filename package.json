{
  "name": "atcoder-ruby-ide",
  "version": "0.2.0",
  "description": "A personal desktop Ruby IDE for AtCoder practice",
  "author": "yu-suke0919",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "tauri dev --features desktop",
    "test": "cargo test --locked --workspace && node --test --test-isolation=none tests/unit/*.test.cjs",
    "test:e2e": "node --test --test-isolation=none tests/e2e/*.test.cjs",
    "prepare:ruby": "node --use-env-proxy scripts/prepare-ruby.cjs",
    "build:win": "npm run prepare:ruby && tauri build --features desktop",
    "package:win": "node scripts/package-windows.cjs"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.64.1"
  }
}

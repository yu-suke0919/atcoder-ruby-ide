{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtCoder Ruby IDE",
  "mainBinaryName": "atcoder-ruby-ide",
  "version": "0.2.0",
  "identifier": "io.github.yu-suke0919.atcoder-ruby-ide",
  "build": { "frontendDist": "../src", "features": ["desktop"] },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "AtCoder Ruby IDE", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 650, "backgroundColor": "#11151d", "devtools": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/icon.ico"],
    "resources": { "../vendor/ruby/": "ruby/" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser", "compression": "lzma" } }
  }
}
